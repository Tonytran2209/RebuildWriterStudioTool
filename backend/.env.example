# AI providers (configure at least one)
OPENAI_API_KEY=
ANTHROPIC_API_KEY=
GOOGLE_API_KEY=
MISTRAL_API_KEY=
TOGETHER_API_KEY=
GROQ_API_KEY=
DEEPSEEK_API_KEY=

# Required for email/password login through Supabase Auth.
SUPABASE_URL=
SUPABASE_SECRET_KEY=
SUPABASE_PUBLISHABLE_KEY=
SUPABASE_AUTH_REDIRECT_URL=https://your-app.example.com
# Comma-separated admin email addresses. Alternatively assign
# app_metadata.role = "admin" in Supabase Auth for a user.
ADMIN_EMAILS=

# Explicit database switch. URL alone never switches provider.
DATABASE_PROVIDER=supabase
DATABASE_URL=
# CLI import only; database password, not a Supabase API key.
SOURCE_DATABASE_URL=
# Keep original Storage until verified file copy completes.
DOCUMENT_STORAGE_PROVIDER=supabase
DOCUMENT_STORAGE_ROOT=
# Freeze all API activity for final import/cutover; drain jobs before enabling.
WRITER_MAINTENANCE_MODE=false
WRITER_MAINTENANCE_ALLOW_ADMIN=false
# Legacy startup projection is disabled. Do not enable during migration.
RUN_LEGACY_PROJECTION_ON_START=false

# Optional Agent Hub MD Library overrides. By default the backend reads the
# repository's ../.agent-hub directory and resolves the current Git commit.
# Set these on deployments that use a different checkout layout or omit .git.
AGENT_LIBRARY_ROOT=
AGENT_LIBRARY_SOURCE_COMMIT=

# Step 2 SEO research uses OpenAI Web Search through OPENAI_API_KEY above.
