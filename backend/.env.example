# AI providers (configure at least one)
OPENAI_API_KEY=
ANTHROPIC_API_KEY=
GOOGLE_API_KEY=
MISTRAL_API_KEY=
TOGETHER_API_KEY=
GROQ_API_KEY=
DEEPSEEK_API_KEY=

# Required for email/password login through Supabase Auth.
SUPABASE_URL=
SUPABASE_PUBLISHABLE_KEY=
SUPABASE_AUTH_REDIRECT_URL=https://your-app.example.com
# Comma-separated admin email addresses. Alternatively assign
# app_metadata.role = "admin" in Supabase Auth for a user.
ADMIN_EMAILS=

# Optional Agent Hub MD Library overrides. By default the backend reads the
# repository's ../.agent-hub directory and resolves the current Git commit.
# Set these on deployments that use a different checkout layout or omit .git.
AGENT_LIBRARY_ROOT=
AGENT_LIBRARY_SOURCE_COMMIT=

# Step 2 SEO research uses OpenAI Web Search through OPENAI_API_KEY above.
