# ─── PORT (Railway tự set, không cần đổi) ────────────────────────────────────
PORT=3000

# ─── Supabase ─────────────────────────────────────────────────────────────────
# Lấy từ: https://supabase.com/dashboard/project/avflicunyavlfnsmpzxy/settings/api
SUPABASE_URL=https://avflicunyavlfnsmpzxy.supabase.co
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key-here
# (Service Role Key khác với Anon Key — có full quyền DB, giữ bí mật)

# ─── Anthropic Claude ─────────────────────────────────────────────────────────
# Lấy từ: https://console.anthropic.com/settings/keys
ANTHROPIC_API_KEY=sk-ant-...

# ─── OpenAI ───────────────────────────────────────────────────────────────────
# Lấy từ: https://platform.openai.com/api-keys
OPENAI_API_KEY=sk-proj-...

# ─── Google Gemini ────────────────────────────────────────────────────────────
# Lấy từ: https://aistudio.google.com/app/apikey
GOOGLE_API_KEY=AIza...

# ─── Mistral AI ───────────────────────────────────────────────────────────────
# Lấy từ: https://console.mistral.ai/api-keys/
MISTRAL_API_KEY=...

# ─── Groq (Llama siêu nhanh) ─────────────────────────────────────────────────
# Lấy từ: https://console.groq.com/keys
GROQ_API_KEY=gsk_...

# ─── Together AI (tùy chọn) ───────────────────────────────────────────────────
# Lấy từ: https://api.together.xyz/settings/api-keys
TOGETHER_API_KEY=...
